x="3" text="" resource-id="" class="android.view.View" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,692][1041,827]" drawing-order="0" hint=""><node index="0" text="ASME B31.3-2018 — الأنابيب الصناعية" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[175,731][973,788]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,702][1041,816]" drawing-order="0" hint="" /></node><node index="4" text="المعادلة ومرجع الكود" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[720,883][1007,940]" drawing-order="0" hint="" /><node index="5" text="ASME B31.3-2018, 304.2.3&#10;q = T - c; r2 = (D - T)/2; theta = angle/(2 joints)&#10;(4a) Pm = S E W q/r2 * q/[q + 0.643 tan(theta) sqrt(r2 q)]&#10;(4b) Pm = S E W q/r2 * (R1-r2)/(R1-0.5 r2)&#10;Multiple: min(4a,4b), theta &lt;= 22.5 deg&#10;Single: (4a) if theta &lt;= 22.5 deg; otherwise (4c)&#10;(4c): use 1.25 instead of 0.643 in (4a)&#10;(5) R1 &gt;= A/tan(theta) + D/2 (empirical A, not allowance c)" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[73,963][1007,1425]" drawing-order="0" hint="" /><node index="6" text="معادلات الضغط تستخدم MPa: قيمة الضغط بالبار × 0.1 = MPa. الأقطار وأنصاف الأقطار والسماكات بالملليمتر، وS بوحدة MPa؛ المعاملات E/W/Y بلا وحدة. معادلات المايل تنتج Pm بوحدة MPa وتحوله الشاشة إلى بار." resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[73,1448][1007,1577]" drawing-order="0" hint="" /><node index="7" text="B31.3-2018 الفقرة 304.2.3: المتعدد يستخدم (4a)/(4b)، والمفرد يستخدم (4a) حتى 22.5° و(4c) فوقها. تحقق من نصف القطر (5) وامتداد السمك M. يستخدم B31.1-2022 مساري 10/100 psi والتأهيل وفق 104.7. θ نصف الانحراف عند الوصلة." resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[39,1634][1041,1763]" drawing-order="0" hint="" /><node index="8" text="القطر الخارجي D (مم)" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[163,1821][1041,1864]" drawing-order="0" hint="" /><node index="9" text="" resource-id="" class="android.view.View" package="com.ahmedismail.flowtrack" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" passwor