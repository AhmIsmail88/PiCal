able="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[124,862][998,939]" drawing-order="0" hint="" /><node index="1" text="" resource-id="" class="android.widget.Button" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,835][1154,965]" drawing-order="0" hint="" /></node><node index="4" text="Design equation and code reference" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1043][953,1120]" drawing-order="0" hint="" /><node index="5" text="ASME B31.3-2018, 304.2.3&#10;q = T - c; r2 = (D - T)/2; theta = angle/(2 joints)&#10;(4a) Pm = S E W q/r2 * q/[q + 0.643 tan(theta) sqrt(r2 q)]&#10;(4b) Pm = S E W q/r2 * (R1-r2)/(R1-0.5 r2)&#10;Multiple: min(4a,4b), theta &lt;= 22.5 deg&#10;Single: (4a) if theta &lt;= 22.5 deg; otherwise (4c)&#10;(4c): use 1.25 instead of 0.643 in (4a)&#10;(5) R1 &gt;= A/tan(theta) + D/2 (empirical A, not allowance c)" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1146][1115,1874]" drawing-order="0" hint="" /><node index="6" text="Pressure equations use MPa: input bar × 0.1 = MPa. D, R and wall dimensions are in mm; S is MPa. E/W/Y are unitless. Miter equations produce Pm in MPa; the screen converts it to bar." resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1900][1115,2108]" drawing-order="0" hint="" /><node index="7" text="B31.3-2018 304.2.3: multiple miters use (4a)/(4b); a single joint uses (4a) up to 22.5° and (4c) above it. Verify radius (5) and wall extension M. B31.1-2022 uses the 10/100 psi paths and qualification under 104.7. θ is half the deflection per joint." resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,2173][1154,2175]" drawing-order="0" hint="" /></node><node index="2" text="PiCal" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[202,154][329,228]" drawing-order="0" hint="" /><node index="3" text="CALCULATORS" resource-id="" class="android.widget.TextView" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[202,228][514,288]" drawing-order="0" hint="" /><node index="4" text="" resource-id="" class="android.view.View" package="com.ahmedismail.flowtrack.readme" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[547,143][703,299]" drawing-order="0" hint=""><node index="0" text="" resource-id="" 